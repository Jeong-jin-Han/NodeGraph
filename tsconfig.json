{
  "compilerOptions": {
    // esbuild가 번들하므로 tsc는 타입 검사 전용이다. shiki처럼 package.json "exports"로만
    // 하위 경로를 노출하는 패키지를 해석하려면 bundler 해석이 필요하다.
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
