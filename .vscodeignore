# Source and build tooling — not needed at runtime
src/
esbuild.js
tsconfig.json
package-lock.json

# Test and temp folders
tmp/
test/
test-demo/
# Scratch folder used to regenerate a demo graph from scratch while developing.
# It is gitignored, but .vscodeignore is independent of .gitignore — without this
# line its 35MB PDF ships inside the .vsix.
demo/ex4-new/
demo/ex6/
demo/ex4-new-v2/
demo/ex7/

# demo/ex5 is tracked in git and linked from the README Benchmark table,
# but intentionally excluded from the packaged .vsix (unlike ex1-ex4)
demo/ex5/

# Packaged .vsix builds (kept in packages/, one per released version)
*.vsix

# Dev-only build output (sourcemaps — only emitted by non-production builds)
dist/**/*.map

# Dev dependencies
node_modules/

# Git and editor internals
.git/
.gitignore
.vscode/
.claude/
